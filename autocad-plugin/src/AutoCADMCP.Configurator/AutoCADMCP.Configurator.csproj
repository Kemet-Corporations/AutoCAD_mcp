<Project Sdk="Microsoft.NET.Sdk">

  <!--
    KEMET: connects AI apps (Claude Desktop, Claude Code, Codex, Cursor, ...) to the AutoCAD
    MCP server by adding or removing the "autocad-mcp" entry in each app's own config file.
    Ported from the Kemet fork of NavisHelper's McpConfigurator (MIT, see NOTICE.md), so the
    Kemet AutoCAD Addons window can drive it with the same command line as the Navisworks one
    (status, configure, remove; see Program.cs). XML comments cannot contain two dashes in a
    row, so the options are not spelled out here.

    Self-contained single exe, like autocad-mcp-server.exe: users install no .NET runtime.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AutoCADMCP.Configurator</RootNamespace>
    <AssemblyName>autocad-mcp-configurator</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same version as NavisHelper's configurator, whose Codex TOML code this reuses. -->
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

</Project>
